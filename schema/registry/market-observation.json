{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afi.example/schema/registry/market-observation.json",
  "title": "MarketObservation — dated sourced measurement",
  "description": "Series asOf source, freshness class. Not Assumption.",
  "type": "object",
  "properties": {
    "ontologyVersion": {
      "const": "v1"
    },
    "series": {
      "type": "string",
      "enum": ["UF", "CPI", "FX_USDCLP", "TPM", "CPI_VAR"]
    },
    "asOf": {
      "type": "string",
      "format": "date"
    },
    "source": {
      "type": "string"
    },
    "value": {
      "type": "number"
    },
    "unit": {
      "$ref": "unit.json"
    },
    "freshnessClass": {
      "enum": ["intraday", "daily", "monthly"]
    }
  },
  "required": ["series", "asOf", "source", "value", "unit", "ontologyVersion"],
  "additionalProperties": false
}
