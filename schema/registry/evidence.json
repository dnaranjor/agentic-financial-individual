{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afi.example/schema/registry/evidence.json",
  "title": "Evidence — immutable source artifact",
  "description": "Identity = content hash SHA-256. Immutable payload retained with retention/erasure on payload not identity.",
  "type": "object",
  "propertyNames": {
    "not": {
      "pattern": "^jurisdiction"
    }
  },
  "properties": {
    "ontologyVersion": {
      "const": "v1"
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "payloadRef": {
      "type": "string",
      "description": "vault ref or transcript id"
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time"
    },
    "mimeType": {
      "type": "string"
    }
  },
  "required": ["hash", "payloadRef", "capturedAt", "ontologyVersion"],
  "additionalProperties": false
}
