#!/bin/sh
# AFI — AWP-000A IU-003: PII guard (000A:12.6)
# Traceability: ADR-023/TAD-15, RT-C01, STAGE-8-PLAN-DELTA.md:7.1/9.1, AWP-000A IU-003
# Rejects commits containing client_net_salary or RUT pattern (excludes hook definition itself)
# Bypass only with --no-verify and reviewer note (logged)

# Scan staged diff (cached) excluding hook file itself
if git diff --cached --unified=0 -- . ':!.githooks/pre-commit' | grep -Eq "client_net_salary|[0-9]{1,2}\.[0-9]{3}\.[0-9]{3}-[0-9kK]"; then
  echo "hook: PII pattern rejected — staged diff contains client_net_salary or RUT pattern" >&2
  echo "hook: Remove PII or document classification in M0-forensics.md / M0-answers.md (000B)" >&2
  echo "hook: To bypass (requires reviewer): git commit --no-verify with justification" >&2
  exit 1
fi
exit 0
